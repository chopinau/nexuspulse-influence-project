{
  "rewrites": [
    { "source": "/api/py/index", "destination": "/api/index.py" },
    { "source": "/api/agent-forum", "destination": "/api/agent-forum" }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "python_backend/**",
      "excludeFiles": [
        "python_backend/data/**",
        "node_modules/**",
        ".next/**",
        "data/**",
        "tests/**",
        "**/*.md",
        "**/*.log",
        "**/*.txt",
        "**/*.tsbuildinfo"
      ]
    },
    "app/api/**/*.ts": {
      "excludeFiles": [
        "node_modules/@google/genai/**",
        "node_modules/@tremor/react/**",
        "node_modules/chart.js/**",
        "node_modules/react-chartjs-2/**",
        "node_modules/recharts/**",
        "node_modules/mermaid/**",
        "node_modules/chevrotain/**",
        "node_modules/embla-carousel-react/**",
        "node_modules/input-otp/**",
        "node_modules/cmdk/**",
        "node_modules/@radix-ui/**"
      ]
    }
  }
}